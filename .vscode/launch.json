{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch sam_sim",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/sam_sim",
      "args": [],
      "cwd": "${workspaceFolder}/build",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
